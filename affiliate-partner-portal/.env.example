PORT=3000

# OIDC identity provider for partner and admin accounts.
OIDC_ISSUER=https://login.example.com/
OIDC_AUDIENCE=affiliate-portal-api
OIDC_JWKS_URL=https://login.example.com/.well-known/jwks.json
OIDC_CLIENT_ID=affiliate-portal-web
OIDC_AUTHORITY=https://login.example.com/
OIDC_API_SCOPE=api://affiliate-portal-api/access_as_user

# Map verified OIDC subject IDs to Partner Name values in Report Level.xlsx.
# Example: {"subject-id-from-idp":"Adnext"}
PARTNER_ACCOUNT_MAP_JSON={}
ADMIN_ROLE_CLAIM=roles
ADMIN_ROLE_NAME=affiliate-admin

# Local folder backed up to Google Drive for desktop on this machine.
# On the portal server, set this to that server's corresponding local sync path.
EXPORT_DATA_DIR=C:\Users\40980\Downloads\AFF Partner Portal
ADMIN_EXPORT_FILENAME=Sampled X Orignal.xlsx
PARTNER_EXPORT_FILENAME=Report Level.xlsx

